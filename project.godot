; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Ralph Wolf - Sheep Raider Native"
config/description="Native modern PC port of Sheep, Dog 'n' Wolf (Looney Tunes: Sheep Raider) in Godot 4."
config/version="1.0.0"
run/main_scene="res://scenes/startup/UpdateGate.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.025, 0.035, 0.07, 1)
boot_splash/image="res://assets/ui/boot/splash.png"
config/icon="res://icon.svg"

[autoload]

ContentUpdates="*res://scripts/updates/content_updates.gd"
LanguageMenu="*res://scripts/updates/autoload_bridge.gd"
LevelLoading="*res://scripts/updates/autoload_bridge.gd"
MobileControls="*res://scripts/updates/autoload_bridge.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"

